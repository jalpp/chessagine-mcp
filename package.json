{
  "name": "chessagine-mcp",
  "version": "0.8.1",
  "description": "",
  "type": "module",
  "main": "build/runner/stdio.js",
  "bin": "build/runner/stdio.js",
  "exports": {
    ".": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    }
  },
  "scripts": {
    "build:vercel": "tsc && tsc && shx chmod +x build/runner/remote.js",
    "build:mcp": "tsc && shx chmod +x build/runner/stdio.js && npm prune --omit=dev && mcpb pack",
    "postbuild:mcp": "npm install",
    "build:ui": "npm run build:chess-board && npm run build:pgn-viewer",
    "build:chess-board": "cross-env BUILD_APP=chess-board vite build",
    "build:pgn-viewer": "cross-env BUILD_APP=pgn-viewer vite build",
    "build": "npm run build:ui && npm run build:mcp",
    "publish": "npm run clean && npm run build",
    "isReady": "npm run publish && npm run test",
    "debug": "npx @modelcontextprotocol/inspector node build/runner/stdio.js",
    "start": "node build/runner/stdio.js",
    "remote": "node build/runner/remote.js",
    "releasetest": "npm run clean && npm run build && npm run test",
    "clean": "shx rm -rf build dist",
    "hardclean": "shx rm -rf node_modules",
    "test": "python runSmokeTest.py --env local"
  },
  "keywords": [],
  "author": "Jalp",
  "license": "MIT & GPL",
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@jalpp/mcp-adapter": "^4.0.0",
    "@modelcontextprotocol/express": "^2.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/inspector": "^2.8.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "axios": "^1.20.0",
    "chess.js": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@mliebelt/pgn-viewer": "^1.6.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "express": "^5.2.1",
    "mcp-handler": "^2.2.0",
    "nodemon": "^3.1.14",
    "react": "^19.3.0",
    "react-chessboard": "^5.12.1",
    "react-dom": "^19.3.0",
    "shx": "^0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
